# Configuracao local do LABCONT-AI. O iniciar.bat cria o .env a partir deste arquivo.

# Banco usado pelo sistema (criado automaticamente na primeira execucao).
DATABASE_URL=postgresql+psycopg://labcont:labcont@localhost:5432/labcont

# Senha do administrador do PostgreSQL (definida na instalacao do PostgreSQL).
# Usada SOMENTE para criar o usuario e o banco acima na primeira execucao.
# Depois que o banco existir, pode apagar a senha daqui.
PG_ADMIN_USUARIO=postgres
PG_ADMIN_SENHA=

# Protecao de acesso (HTTP Basic). Deixe vazio no computador local.
# OBRIGATORIO preencher antes de publicar no servidor (dados reais de alunos).
APP_USUARIO=
APP_SENHA=
